<settings>
    <global>
        <EnableRecast>true</EnableRecast>
        <DisplaySelfSingleTargetBuffs>true</DisplaySelfSingleTargetBuffs>
        <DisplaySelfTargetAoEBuffs>true</DisplaySelfTargetAoEBuffs>
        <EnableBuffs>true</EnableBuffs>
        <GraphicalMode>true</GraphicalMode>
        <ExtendText>true</ExtendText>
        <TextColoring>false</TextColoring>
        <SlimMode>true</SlimMode>
        <ShowTenths>true</ShowTenths>
        <!--One of: Alphabetical, Creation, Duration-->
        <SortType>Creation</SortType>
        <Show1HourName>true</Show1HourName>
        <HighRed>255</HighRed>
        <HighGreen>0</HighGreen>
        <HighBlue>0</HighBlue>
        <MedPercent>0.5</MedPercent>
        <MedRed>255</MedRed>
        <MedGreen>160</MedGreen>
        <MedBlue>0</MedBlue>
        <LowPercent>0.25</LowPercent>
        <LowRed>0</LowRed>
        <LowGreen>255</LowGreen>
        <LowBlue>0</LowBlue>
        <TextA>255</TextA>
        <TextR>255</TextR>
        <TextG>255</TextG>
        <TextB>255</TextB>
        <RecastLowToHigh>true</RecastLowToHigh>
        <BuffsLowToHigh>false</BuffsLowToHigh>
        <CustomLowToHigh>false</CustomLowToHigh>
        <BGA>128</BGA>
        <BGR>0</BGR>
        <BGG>0</BGG>
        <BGB>0</BGB>
        <RecastFlashDuration>2</RecastFlashDuration>
        <BuffsFlashDuration>2</BuffsFlashDuration>
        <CustomFlashDuration>2</CustomFlashDuration>
        <FlashR>255</FlashR>
        <FlashG>255</FlashG>
        <FlashB>0</FlashB>
        <FontName>Arial</FontName>
        <FontSize>10</FontSize>
        <FontBold>false</FontBold>
        <BarSpacing>0</BarSpacing>
        <RecastTimerLimit>10</RecastTimerLimit>
        <BuffsTimerLimit>10</BuffsTimerLimit>
        <CustomTimerLimit>10</CustomTimerLimit>
        <!-- Recast top-left; buff/custom on the right — mid-left is keylabels. -->
        <RecastX>20</RecastX>
        <RecastY>70</RecastY>
        <BuffsX>900</BuffsX>
        <BuffsY>320</BuffsY>
        <CustomX>900</CustomX>
        <CustomY>520</CustomY>
        <!--If true, only items on the recast/buff lists will be displayed-->
        <WhitelistMode>false</WhitelistMode>
        <!--List of ability names to display recasts for if in whitelistMode and to exclude otherwise-->
        <AbilityRecastFilter />
        <!--Trust names. WhitelistMode false makes this a blacklist. screenfit writes this back after Timers saves, because an unload clears it.-->
        <SpellRecastFilter>Shantotto|Naji|Kupipi|Excenmille|Ayame|Nanaa Mihgo|Curilla|Volker|Ajido-Marujido|Trion|Zeid|Lion|Tenzen|Mihli Aliapoh|Valaineral|Joachim|Naja Salaheem|Prishe|Ulmia|Shikaree Z|Cherukiki|Iron Eater|Gessho|Gadalar|Rainemard|Ingrid|Lehko Habhoka|Nashmeira|Zazarg|Ovjang|Mnejing|Sakura|Luzaf|Najelith|Aldo|Moogle|Fablinix|Maat|D. Shantotto|Star Sibyl|Karaha-Baruha|Cid|Gilgamesh|Areuhat|Semih Lafihna|Elivira|Noillurie|Lhu Mhakaracca|Ferreous Coffin|Lilisette|Mumor|Uka Totlihn|Klara|Romaa Mihgo|Kuyin Hathdenna|Rahal|Koru-Moru|Pieuje (UC)|I. Shield (UC)|Apururu (UC)|Jakoh (UC)|Flaviria (UC)|Babban|Abenzio|Rughadjeen|Kukki-Chebukki|Margret|Chacharoon|Lhe Lhangavo|Arciela|Mayakov|Qultada|Adelheid|Amchuchu|Brygid|Mildaurion|Halver|Rongelouts|Leonoyne|Maximilian|Kayeel-Payeel|Robel-Akbel|Kupofried|Selh&apos;teus|Yoran-Oran (UC)|Sylvie (UC)|Abquhbah|Balamor|August|Rosulatia|Teodor|Ullegore|Makki-Chebukki|King of Hearts|Morimar|Darrcuiln|AAHM|AAEV|AAMR|AATT|AAGK|Iroha|Ygnas|Monberaux|Cornelia|Matsui-P|Excenmille [S]|Ayame (UC)|Maat (UC)|Aldo (UC)|Naja (UC)|Lion II|Zeid II|Prishe II|Nashmeira II|Lilisette II|Tenzen II|Mumor II|Ingrid II|Arciela II|Iroha II|Shantotto II</SpellRecastFilter>
        <!--List of ability names to display buffs for if in whitelistMode and to exclude otherwise-->
        <AbilityBuffFilter />
        <!--List of spell names to display buffs for if in whitelistMode and to exclude otherwise-->
        <SpellBuffFilter />
        <!--If true will show a font outline-->
        <Stroke>false</Stroke>
    </global>
</settings>
